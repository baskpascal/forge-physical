# Public web configuration. Put these in Vercel, not Secret Manager.
NEXT_PUBLIC_BUILD_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend non-sensitive configuration. Cloud Run environment variables in production.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# Vertex inference can use a Gemini multi-region independently from Cloud Run.
VERTEX_LOCATION=us
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash

# State and dispatch. Use firestore in Cloud; local is an honest dev fallback.
BUILD_STORE=local
BUILD_DATA_DIR=./data
BUILD_ARTIFACT_DIR=./artifacts
ARTIFACT_BUCKET=
PUBLIC_BUILD_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8080
WORKER_DISPATCH_URL=
CLOUD_RUN_JOB_NAME=

# Tooling configuration (non-sensitive)
PLATFORMIO_CMD=platformio
MAX_REPAIR_ATTEMPTS=3
WOKWI_CLI_CMD=wokwi-cli

# Secrets are intentionally absent. Production injects WOKWI_CLI_TOKEN (and any
# future private API key) from Google Secret Manager. For local use, run:
#   .\scripts\with-gcp-secrets.ps1 -Command npm -CommandArgs @('run','smoke')
